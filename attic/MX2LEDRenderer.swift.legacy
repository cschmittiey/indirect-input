import Foundation
import BridgeCore

public struct MX2RGB: Equatable, Sendable {
    public var red: Int
    public var green: Int
    public var blue: Int

    public init(red: Int, green: Int, blue: Int) {
        self.red = red
        self.green = green
        self.blue = blue
    }
}

public struct MX2LEDState: Equatable, Sendable {
    public var banks: [MX2PadBank] = [.hotcues, .hotcues]
    public var shift: [Bool] = [false, false]
    public var playing: [Bool] = [false, false]
    public var cuePressed: [Bool] = [false, false]
    public var sync: [Bool] = [false, false]
    public var master: [Bool] = [false, false]
    public var keyLock: [Bool] = [false, false]
    public var slip: [Bool] = [false, false]
    public var reverse: [Bool] = [false, false]
    public var headphone: [Bool] = [false, false]
    public var looping: [Bool] = [false, false]
    public var playerTypes: [String] = ["empty", "empty"]
    public var meters: [Double] = [0, 0]
    public var cueColors: [[Int]] = Array(repeating: Array(repeating: 0, count: 8), count: 2)
    public var palette: [Int: MX2RGB] = [:]
    public var padPressed: [[Bool]] = Array(repeating: Array(repeating: false, count: 8), count: 2)

    public init() {}
}

public struct MX2LEDRenderer: Sendable {
    public init() {}

    public func render(_ state: MX2LEDState) -> [UInt8] {
        var image = [UInt8](repeating: 0, count: 105)
        for sideIndex in 0..<2 {
            let base = sideIndex == 0 ? 1 : 31
            let bank = state.banks[sideIndex]
            for index in 0..<4 {
                image[base + index] = Self.color(3, lit: true)
            }
            image[base + 4] = Self.color(11, lit: true)
            image[base + 5] = Self.color(11, lit: true)
            image[base + 6] = Self.color(11, lit: true)
            image[base + 7] = Self.color(11, lit: true)
            image[base + 8] = Self.color(1, lit: state.slip[sideIndex])
            image[base + 9] = Self.color(1, lit: state.reverse[sideIndex])
            image[base + 10] = Self.color(11, lit: true)
            image[base + 11] = Self.color(11, lit: true)
            image[base + 12] = Self.color(18, lit: state.shift[sideIndex])
            image[base + 13] = Self.color(11, lit: state.sync[sideIndex])
            image[base + 14] = Self.color(11, lit: state.master[sideIndex])
            image[base + 15] = Self.color(11, lit: state.keyLock[sideIndex])
            image[base + 16] = Self.color(11, lit: bank == .hotcues)
            image[base + 17] = Self.color(14, lit: bank == .stems)
            image[base + 18] = Self.color(3, lit: bank == .pattern)
            image[base + 19] = Self.color(7, lit: bank == .loops)
            for pad in 0..<8 {
                let color: Int
                let occupied: Bool
                switch bank {
                case .hotcues:
                    let slot = state.cueColors[sideIndex][pad]
                    if let rgb = state.palette[slot] {
                        color = Self.nearestColor(red: rgb.red, green: rgb.green, blue: rgb.blue)
                    } else {
                        color = Self.cueColor(slot)
                    }
                    occupied = state.cueColors[sideIndex][pad] != 0
                case .stems:
                    color = pad % 4 == 0 ? 14 : 9
                    occupied = true
                case .pattern:
                    color = 3
                    occupied = true
                case .loops:
                    color = 7
                    occupied = true
                }
                let lit = state.padPressed[sideIndex][pad] || (bank == .hotcues && occupied)
                image[base + 20 + pad] = Self.color(color, lit: lit)
            }
            image[base + 28] = Self.color(3, lit: state.cuePressed[sideIndex])
            image[base + 29] = Self.color(7, lit: state.playing[sideIndex])
            let headphoneBase = sideIndex == 0 ? 64 : 68
            image[headphoneBase] = Self.color(18, lit: state.headphone[sideIndex])
            let shellColor = state.looping[sideIndex] ? 7 : 11
            for led in 0..<6 {
                image[(sideIndex == 0 ? 74 : 80) + led] = Self.color(shellColor, lit: true)
            }
            let segments = state.meters[sideIndex] <= 0 ? 0 : min(9, max(1, Int(ceil(state.meters[sideIndex] * 9))))
            for segment in 0..<9 {
                image[(sideIndex == 0 ? 87 : 96) + segment] = segment < segments ? 126 : 0
            }
        }
        return image
    }

    private static func color(_ palette: Int, lit: Bool) -> UInt8 {
        UInt8(palette * 4 + (lit ? 2 : 0))
    }

    private static func nearestColor(red: Int, green: Int, blue: Int) -> Int {
        let palette: [(id: Int, red: Int, green: Int, blue: Int)] = [
            (1, 255, 40, 40), (3, 255, 140, 30), (5, 255, 225, 60),
            (7, 40, 220, 90), (9, 30, 220, 210), (11, 40, 130, 255),
            (14, 155, 65, 230), (15, 235, 60, 210), (18, 235, 235, 235)
        ]
        return palette.min { lhs, rhs in
            let left = pow(Double(lhs.red - red), 2) + pow(Double(lhs.green - green), 2) + pow(Double(lhs.blue - blue), 2)
            let right = pow(Double(rhs.red - red), 2) + pow(Double(rhs.green - green), 2) + pow(Double(rhs.blue - blue), 2)
            return left < right
        }?.id ?? 18
    }

    private static func cueColor(_ slot: Int) -> Int {
        [0, 1, 3, 5, 7, 9, 11, 14, 18][max(0, min(8, slot))]
    }
}
